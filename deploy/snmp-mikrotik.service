[Unit]
Description=MikroTik wAP 60G SNMP link monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_YOUR_USERNAME
WorkingDirectory=/home/REPLACE_WITH_YOUR_USERNAME/snmp-mikrotik
EnvironmentFile=/etc/snmp-mikrotik/env
ExecStart=REPLACE_WITH_UV_ABS_PATH run monitor.py --headless
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
