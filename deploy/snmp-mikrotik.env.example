# Copy to /etc/snmp-mikrotik/env on each R28S and adjust per box.
# monitor.py reads these at startup (see CONFIGURATION section).

LOG_DIR=/var/log/snmp-mikrotik

# Only set on ONE of the two boxes — the other should leave this blank/unset
# so the two boxes don't both launch saturating iperf3 client tests against
# each other at the same time. Both boxes always run an iperf3 *server*
# regardless of this setting.
IPERF_TARGET=

# Uncomment only if this box's route to the AP differs from the default.
# SNMP_MASTER_IP=192.168.1.80
# SNMP_SLAVE_IP=192.168.1.81
